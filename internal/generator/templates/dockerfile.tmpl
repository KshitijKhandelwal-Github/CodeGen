{{ if .MultiStage }}
# Multi-stage build for {{ .ProjectName }}

{{ if eq .PrimaryLang "Go" }}
# Build stage
FROM golang:1.21-alpine AS builder

WORKDIR {{ .WorkDir }}

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o main ./cmd/cli

# Final stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates

WORKDIR /root/

# Copy binary from builder
COPY --from=builder {{ .WorkDir }}/main .

{{ if .Port }}
EXPOSE {{ .Port }}
{{ end }}

{{ if .HasHealthCheck }}
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:{{ .Port }}/health || exit 1
{{ end }}

CMD ["./main"]

{{ else if eq .PrimaryLang "Python" }}
# Build stage
FROM python:3.11-slim AS builder

WORKDIR {{ .WorkDir }}

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --user -r requirements.txt

# Final stage
FROM python:3.11-slim

WORKDIR {{ .WorkDir }}

# Copy dependencies from builder
COPY --from=builder /root/.local /root/.local
ENV PATH=/root/.local/bin:$PATH

# Copy application
COPY . .

{{ if .Port }}
EXPOSE {{ .Port }}
{{ end }}

{{ if .HasHealthCheck }}
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl --fail http://localhost:{{ .Port }}/health || exit 1
{{ end }}

CMD ["python", "{{ range .Analysis.EntryPoints }}{{ if eq .Type "main" }}{{ .Path }}{{ end }}{{ end }}"]

{{ else if eq .PrimaryLang "JavaScript" }}
# Build stage
FROM node:20-alpine AS builder

WORKDIR {{ .WorkDir }}

# Copy package files
COPY package*.json ./
RUN npm ci --only=production

# Final stage
FROM node:20-alpine

WORKDIR {{ .WorkDir }}

# Copy dependencies and app
COPY --from=builder {{ .WorkDir }}/node_modules ./node_modules
COPY . .

{{ if .Port }}
EXPOSE {{ .Port }}
{{ end }}

{{ if .HasHealthCheck }}
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:{{ .Port }}/health || exit 1
{{ end }}

CMD ["node", "{{ range .Analysis.EntryPoints }}{{ if eq .Type "main" }}{{ .Path }}{{ end }}{{ end }}"]

{{ else if eq .PrimaryLang "Rust" }}
# Build stage
FROM rust:1.75-alpine AS builder

WORKDIR {{ .WorkDir }}

# Copy manifest
COPY Cargo.toml Cargo.lock ./

# Copy source
COPY . .

# Build release
RUN cargo build --release

# Final stage
FROM alpine:latest

WORKDIR /root/

# Copy binary
COPY --from=builder {{ .WorkDir }}/target/release/{{ .ProjectName }} .

{{ if .Port }}
EXPOSE {{ .Port }}
{{ end }}

CMD ["./{{ .ProjectName }}"]

{{ end }}

{{ else }}
# Single-stage Dockerfile for {{ .ProjectName }}

{{ if eq .PrimaryLang "Go" }}
FROM golang:1.21-alpine

WORKDIR {{ .WorkDir }}

COPY . .
RUN go mod download
RUN go build -o main ./cmd/cli

{{ if .Port }}
EXPOSE {{ .Port }}
{{ end }}

CMD ["./main"]

{{ else if eq .PrimaryLang "Python" }}
FROM python:3.11-slim

WORKDIR {{ .WorkDir }}

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

{{ if .Port }}
EXPOSE {{ .Port }}
{{ end }}

CMD ["python", "{{ range .Analysis.EntryPoints }}{{ if eq .Type "main" }}{{ .Path }}{{ end }}{{ end }}"]

{{ else if eq .PrimaryLang "JavaScript" }}
FROM node:20-alpine

WORKDIR {{ .WorkDir }}

COPY package*.json ./
RUN npm install

COPY . .

{{ if .Port }}
EXPOSE {{ .Port }}
{{ end }}

CMD ["node", "{{ range .Analysis.EntryPoints }}{{ if eq .Type "main" }}{{ .Path }}{{ end }}{{ end }}"]

{{ end }}
{{ end }}